# Flow Travel DMC — production environment template
# Copy these values into Supabase secrets / deployment environment.
# NEVER commit real API keys or secrets to Git.

AI_PROVIDER=gemini
GEMINI_API_KEY=<your Gemini API key>
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_SMART=gemini-2.5-pro

RESEND_API_KEY=<your Resend API key>
RECAPTCHA_SECRET_KEY=<your reCAPTCHA secret>
SITE_URL=https://your-real-domain.example
ALLOWED_ORIGINS=https://your-real-domain.example

# Optional legacy providers (only if you intentionally use them):
# ANTHROPIC_API_KEY=<your Anthropic key>
# OPENAI_API_KEY=<your OpenAI key>
# AI_MODEL_FAST=<provider fast model>
# AI_MODEL_SMART=<provider smart model>

# Optional demo provider:
# DEMO_API_KEY=<server-side demo key>
# DEMO_API_BASE_URL=https://api.groq.com/openai/v1
# DEMO_MODEL_FAST=llama-3.1-8b-instant
# DEMO_MODEL_SMART=llama-3.3-70b-versatile
